# ==============================================================================
# CatchUp AI — Environment Configuration Template (.env.example)
#
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT:
#   cp .env.example .env
#
# SECURITY NOTICE:
# - Do NOT commit real secrets or .env to version control.
# - GROQ_API_KEY must remain exclusively on the Node.js backend.
# - Never prefix backend secrets with VITE_ to prevent bundling into client JS.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (Node.js + Express)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Allowed CORS Origins (comma-separated list for production/development)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Groq AI Service Configuration (OPTIONAL - Server-Only Secret)
#
# When omitted, the application runs entirely in 100% offline, local rule-based mode.
# When provided, enables optional cloud-assisted entity extraction upon explicit user request.
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Base URL for the Express backend API. If blank, defaults to /api/v1 (using Vite proxy).
VITE_API_BASE_URL=http://localhost:3001/api/v1
